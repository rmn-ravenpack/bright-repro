# Bigdata Content and Search APIs
BIGDATA_API_KEY=...
BIGDATA_API_BASE_URL=https://api.bigdata.com
BIGDATA_RATE_LIMIT_PER_MINUTE=500
BIGDATA_RATE_LIMIT_SAFETY_MARGIN=20
BIGDATA_UPLOAD_MAX_RETRIES=5

# AWS Bedrock: prefer your normal AWS credential chain or an SSO/profile.
AWS_REGION=us-east-1
# AWS_PROFILE=...

# Temporary explicit credentials are also supported when required.
# Do not store long-lived access keys in this file.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
